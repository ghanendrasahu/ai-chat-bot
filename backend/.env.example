# Server-side LLM key. Optional: visitors can bring their own key in
# Settings instead, and then this server needs none at all.
#
# Groq - free forever, no card required, runs openai/gpt-oss-20b
# https://console.groq.com/
# GROQ_API_KEY=
#
# OpenAI - metered, runs gpt-4o-mini ($0.15 / 1M input, $0.60 / 1M output)
# OPENAI_API_KEY=
#
# OpenRouter - one key, most models, some of them free
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=
#
# Override the model name for the default provider.
# AI_MODEL=openai/gpt-oss-120b
#
# Model for the cheap utility calls (chat titles and rolling summaries). They
# use the provider's default model unless this is set, even when the visitor
# picked a large model for the conversation.
# AI_AUX_MODEL=openai/gpt-oss-20b

# Interface to bind. 0.0.0.0 is right for a container; use 127.0.0.1 to keep
# a local run off the network.
# HOST=0.0.0.0

# Optional: require this header on POST /chat: X-Access-Token: <value>.
# CHAT_ACCESS_TOKEN=

# Abuse limits (defaults shown). The limiter is per IP, in memory.
# CHAT_RATE_LIMIT=15
# CHAT_DAILY_LIMIT=400

# Service-wide ceiling, counted on the clock and not on any client address.
# This is what bounds the cost when the per-IP identity cannot be trusted.
# CHAT_GLOBAL_LIMIT=120
# CHAT_GLOBAL_DAILY_LIMIT=1500

# Reply and stream bounds (defaults shown).
# CHAT_MAX_TOKENS=1024
# CHAT_STREAM_TIMEOUT_MS=45000
# CHAT_STREAM_HEARTBEAT_MS=15000

# How many proxy hops to trust when reading X-Forwarded-For. Use 1 behind a
# single proxy (Render). Use 0 when the app is exposed directly, otherwise a
# client can spoof the header and get a fresh rate-limit bucket per request.
# TRUST_PROXY=1

# Cross-origin browser origins allowed to call the API (comma separated).
# Same-origin works without this. Default: http://localhost:5173
# CORS_ORIGIN=https://your-frontend.example.com
