# Server-side LLM key. Set exactly one; Groq wins when both are set.
#
# Groq - free forever, no card required, runs openai/gpt-oss-20b
# https://console.groq.com/
# GROQ_API_KEY=
#
# OpenAI - metered, runs gpt-4o-mini ($0.15 / 1M input, $0.60 / 1M output)
# OPENAI_API_KEY=
#
# Override the model name for the chosen provider.
# AI_MODEL=openai/gpt-oss-120b

# Optional: require this header on POST /chat: X-Access-Token: <value>.
# CHAT_ACCESS_TOKEN=

# Abuse limits (defaults shown). The limiter is per IP, in memory.
# CHAT_RATE_LIMIT=15
# CHAT_DAILY_LIMIT=400

# Cross-origin browser origins allowed to call the API (comma separated).
# Same-origin works without this. Default: http://localhost:5173
# CORS_ORIGIN=https://your-frontend.example.com
